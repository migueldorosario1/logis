---
import { LANGS, type Lang, NAV, UI, langPath, SITE_NAME, MAGAZINE_NAME } from '../content/ui';
import Flag from './Flag.astro';

interface Props {
  lang: Lang;
  slug: string;
}
const { lang, slug } = Astro.props;
const t = UI[lang];

const LANG_NAMES: Record<Lang, string> = { pt: 'Português (Brasil)', en: 'English (USA)', es: 'Español (España)' };
---

<header class="site">
  <div class="container">
    <div class="header-top">
      <a class="brand" href={langPath(lang)}>
        <span class="mark">L</span>
        <span>
          {SITE_NAME}
          <small>{t.tagline} · {MAGAZINE_NAME}</small>
        </span>
      </a>
      <div class="lang-switch">
        {LANGS.map((l) => (
          <a href={langPath(l, slug)} class:list={{ active: l === lang }} title={LANG_NAMES[l]} aria-label={LANG_NAMES[l]}>
            <Flag lang={l} />
          </a>
        ))}
      </div>
    </div>

    <nav class="main" aria-label="Principal">
      <ul>
        {NAV.map((item) => (
          <li>
            <a
              href={langPath(lang, item.slug)}
              class:list={{ active: item.slug === slug }}
            >{item.label[lang]}</a>
          </li>
        ))}
      </ul>
    </nav>

    <details class="menu-mobile">
      <summary>{t.menu}</summary>
      <ul>
        {NAV.map((item) => (
          <li>
            <a
              href={langPath(lang, item.slug)}
              class:list={{ active: item.slug === slug }}
            >{item.label[lang]}</a>
          </li>
        ))}
      </ul>
    </details>
  </div>
</header>
