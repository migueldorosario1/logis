---
import { LANGS, type Lang, NAV_GROUPS, NAV_EXTRAS, UI, langPath, SITE_NAME } from '../content/ui';
import Flag from './Flag.astro';

interface Props {
  lang: Lang;
  slug: string;
}
const { lang, slug } = Astro.props;
const t = UI[lang];

const LANG_NAMES: Record<Lang, string> = { pt: 'Português (Brasil)', en: 'English (USA)', es: 'Español (España)' };
const groupActive = (g: { slug: string; children?: { slug: string }[] }) =>
  g.slug === slug || (g.children?.some((ch) => ch.slug === slug) ?? false);

const REDES = [
  { id: 'x', label: 'X', svg: `<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 4l12 12M16 4L4 16"/></svg>` },
  { id: 'youtube', label: 'YouTube', svg: `<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><rect x="2" y="5" width="16" height="11" rx="3"/><path d="M8.5 8.2l4 2.3-4 2.3z" fill="currentColor" stroke="none"/></svg>` },
  { id: 'linkedin', label: 'LinkedIn', svg: `<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><rect x="2.5" y="2.5" width="15" height="15" rx="3.5"/><circle cx="6.6" cy="7" r="1" fill="currentColor" stroke="none"/><path d="M6.6 9.5v5M9.8 14.5v-5c1.6-1.2 3.6-.6 3.6 1.4v3.6"/></svg>` },
  { id: 'instagram', label: 'Instagram', svg: `<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="2.5" y="2.5" width="15" height="15" rx="4.5"/><circle cx="10" cy="10" r="3.4"/><circle cx="14.6" cy="5.4" r="0.9" fill="currentColor" stroke="none"/></svg>` },
];
---

<header class="site">
  <div class="container">
    <div class="header-top">
      <a class="brand" href={langPath(lang)} aria-label={SITE_NAME}>
        <span class="mark" aria-hidden="true">
          <svg viewBox="0 0 40 40" width="44" height="44" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="40" height="40" rx="11" fill="url(#brand-grad-hdr)"/>
            <path d="M13 11V26C13 27.6569 14.3431 29 16 29H28" stroke="#B5E048" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M21 16L26 21L31 16" stroke="#1E8A66" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.85"/>
            <circle cx="13" cy="11" r="2" fill="#B5E048"/>
            <defs>
              <linearGradient id="brand-grad-hdr" x1="0" y1="0" x2="40" y2="40" gradientUnits="userSpaceOnUse">
                <stop stop-color="#07271E"/>
                <stop offset="0.6" stop-color="#0B3B2E"/>
                <stop offset="1" stop-color="#14664E"/>
              </linearGradient>
            </defs>
          </svg>
        </span>
        <span class="brand-text">
          <span class="brand-name">{SITE_NAME}</span>
        </span>
      </a>
      <div class="header-actions">
        <div class="redes" aria-label="Redes sociais">
          {REDES.map((r) => (
            <a href="#" title={`${r.label} (em breve)`} aria-label={`${r.label} (em breve)`} set:html={r.svg} />
          ))}
        </div>
        <div class="lang-switch" role="navigation" aria-label="Idioma / Language / Idioma">
          {LANGS.map((l) => (
            <a href={langPath(l, slug)} class:list={{ active: l === lang }} title={LANG_NAMES[l]} aria-label={LANG_NAMES[l]}>
              <Flag lang={l} />
            </a>
          ))}
        </div>
      </div>
    </div>

    <nav class="main" aria-label="Navegação principal">
      <ul>
        {NAV_GROUPS.map((g) => (
          g.children ? (
            <li class="has-sub">
              <a
                href={langPath(lang, g.children[0].slug)}
                class:list={{ active: groupActive(g) }}
                aria-haspopup="true"
                aria-expanded="false"
              >{g.label[lang]} <span class="caret" aria-hidden="true">▾</span></a>
              <ul class="sub" role="menu">
                {g.children.map((ch) => (
                  <li role="none"><a href={langPath(lang, ch.slug)} class:list={{ active: ch.slug === slug }} role="menuitem">{ch.label[lang]}</a></li>
                ))}
              </ul>
            </li>
          ) : (
            <li>
              <a href={langPath(lang, g.slug)} class:list={{ active: g.slug === slug }}>{g.label[lang]}</a>
            </li>
          )
        ))}
      </ul>
    </nav>

    <details class="menu-mobile">
      <summary>{t.menu}</summary>
      {NAV_GROUPS.map((g) => (
        <div class="mm-group">
          {g.children ? (
            <>
              <h4>{g.label[lang]}</h4>
              <ul>
                {g.children.map((ch) => (
                  <li><a href={langPath(lang, ch.slug)} class:list={{ active: ch.slug === slug }}>{ch.label[lang]}</a></li>
                ))}
              </ul>
            </>
          ) : (
            <ul>
              <li><a href={langPath(lang, g.slug)} class:list={{ active: g.slug === slug }}>{g.label[lang]}</a></li>
            </ul>
          )}
        </div>
      ))}
      <div class="mm-group">
        <h4>{{ pt: 'Revista & Instituto', en: 'Journal & Institute', es: 'Revista & Instituto' }[lang]}</h4>
        <ul>
          {NAV_EXTRAS.map((ch) => (
            <li><a href={langPath(lang, ch.slug)} class:list={{ active: ch.slug === slug }}>{ch.label[lang]}</a></li>
          ))}
        </ul>
      </div>
    </details>
  </div>

  <script is:inline>
    // Submenus estáveis: 1º clique fixa o menu aberto (.open), 2º clique navega;
    // clique fora ou ESC fecha; hover/foco continuam funcionando como atalho.
    (function () {
      var itens = document.querySelectorAll('nav.main li.has-sub > a');
      itens.forEach(function (a) {
        a.addEventListener('click', function (e) {
          var li = a.parentElement;
          var aberto = li.classList.contains('open');
          document.querySelectorAll('nav.main li.has-sub.open').forEach(function (o) {
            if (o !== li) { o.classList.remove('open'); o.querySelector('a').setAttribute('aria-expanded', 'false'); }
          });
          if (!aberto) {
            e.preventDefault();
            li.classList.add('open');
            a.setAttribute('aria-expanded', 'true');
          } else {
            a.setAttribute('aria-expanded', 'false');
          }
        });
      });
      document.addEventListener('click', function (e) {
        document.querySelectorAll('nav.main li.has-sub.open').forEach(function (li) {
          if (!li.contains(e.target)) {
            li.classList.remove('open');
            li.querySelector('a').setAttribute('aria-expanded', 'false');
          }
        });
      });
      document.addEventListener('keydown', function (e) {
        if (e.key !== 'Escape') return;
        document.querySelectorAll('nav.main li.has-sub.open').forEach(function (li) {
          li.classList.remove('open');
          li.querySelector('a').setAttribute('aria-expanded', 'false');
        });
      });
    })();
  </script>
</header>
