---
import { NOVAS_REPORTAGENS_20261031 } from '../data/novas-reportagens-20261031';
import { slugRep } from '../data/reportagens';
import { type Lang, langPath } from '../content/ui';
const { lang } = Astro.props as { lang: Lang };
const T = { pt: { title: 'Novos artigos · soberania e tecnologia', read: 'Ler artigo' }, en: { title: 'New articles · sovereignty and technology', read: 'Read article' }, es: { title: 'Nuevos artículos · soberanía y tecnología', read: 'Leer artículo' } }[lang];
---
<section class="block novas-publicacoes" aria-label={T.title}>
  <div class="container">
    <h2 class="group-title">{T.title}</h2>
    <div class="novos-grid">
      {NOVAS_REPORTAGENS_20261031.map(r => (
        <a class="novo-artigo" href={langPath(lang, `reportagens/${slugRep(r,lang)}`)}>
          <img src={r.foto.src} alt={r.ilustracao?.[lang].descricao ?? r.foto.descricao} loading="lazy" width="1672" height="941" />
          <div class="novo-conteudo">
            <span class="kicker">{r.kicker[lang]} · {r.data}</span>
            <h3>{r.titulo[lang]}</h3>
            <p>{r.olho[lang]}</p>
            <strong>{T.read} →</strong>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
<style>
.novas-publicacoes { background: #f1f5ef; }
.novos-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:24px; }
.novo-artigo { display:block; color:inherit; text-decoration:none; background:white; border:1px solid #dce5dd; border-radius:16px; overflow:hidden; }
.novo-artigo img { display:block; width:100%; height:auto; aspect-ratio:1672/941; object-fit:cover; }
.novo-conteudo { padding:24px; }
.novo-conteudo h3 { font-size:clamp(1.35rem,2.3vw,1.9rem); line-height:1.2; margin:12px 0; }
.novo-conteudo p { line-height:1.65; }
.novo-conteudo strong { color:#14664e; }
.novo-artigo:hover { border-color:#14664e; }
.novo-artigo:focus-visible { outline:3px solid #14664e; outline-offset:4px; }
@media(max-width:680px){ .novos-grid { grid-template-columns:1fr; } .novo-conteudo { padding:20px; } }
</style>
