---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import { LANGS, type Lang } from '../../content/ui';
import { PAGES } from '../../content/pages';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const c = PAGES.revista[lang];
const title = `${c.hero.title} — LOGIS`;

const T = {
  pt: {
    dlTitulo: 'Prévia da edição nº 1 — capa e sumário (PDF)',
    dlTexto: 'Baixe a prévia da edição nº 1: capa com o dossiê "corredores de escoamento e controle logístico" e sumário com o que já existe — o editorial e a reportagem publicados no portal — e as seções que abrem com a chamada de trabalhos. Conteúdo real, nada demonstrativo.',
    dlBtn: '⬇ PDF em português',
    dlOutros: 'Também disponível:',
    dlEn: 'English PDF',
    dlEs: 'PDF en español',
  },
  en: {
    dlTitulo: 'Issue #1 preview — cover and contents (PDF)',
    dlTexto: 'Download the Issue #1 preview: a cover with the "export corridors and logistics control" dossier and a contents page listing what already exists — the editorial and the feature story published on the portal — plus the sections opening with the call for papers. Real content, nothing dummy.',
    dlBtn: '⬇ PDF in English',
    dlOutros: 'Also available:',
    dlEn: 'PDF em português',
    dlEs: 'PDF en español',
  },
  es: {
    dlTitulo: 'Avance de la edición nº 1 — portada y sumario (PDF)',
    dlTexto: 'Descargue el avance de la edición nº 1: portada con el dossier "corredores de escoamiento y control logístico" y sumario con lo que ya existe — el editorial y el reportaje publicados en el portal — y las secciones que abren con la convocatoria de trabajos. Contenido real, nada demostrativo.',
    dlBtn: '⬇ PDF en español',
    dlOutros: 'También disponible:',
    dlEn: 'PDF em português',
    dlEs: 'English PDF',
  },
}[lang];

const PDF_PT = '/downloads/revista-logis-edicao1-pt.pdf';
const PDF_EN = '/downloads/revista-logis-edicao1-en.pdf';
const PDF_ES = '/downloads/revista-logis-edicao1-es.pdf';
---

<Base lang={lang} slug="revista" title={title} description={c.hero.sub}>
  <Section lang={lang} slug="revista" />

  <section class="block alt">
    <div class="container">
      <div class="download-box">
        <div>
          <h3>{T.dlTitulo}</h3>
          <p>{T.dlTexto}</p>
        </div>
        <div class="revista-downloads">
          <a class="btn primary" href={lang === 'en' ? PDF_EN : lang === 'es' ? PDF_ES : PDF_PT} download>{T.dlBtn}</a>
          <span class="revista-downloads-outros">
            {T.dlOutros}
            <a href={PDF_PT} download>{lang === 'pt' ? T.dlEn : 'português'}</a> ·
            <a href={PDF_EN} download>{lang === 'en' ? T.dlEn : 'english'}</a> ·
            <a href={PDF_ES} download>{lang === 'es' ? T.dlEn : 'español'}</a>
          </span>
        </div>
      </div>
    </div>
  </section>
</Base>
