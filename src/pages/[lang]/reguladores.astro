---
import Base from '../../layouts/Base.astro';
import { LANGS, type Lang } from '../../content/ui';
import { PAGES } from '../../content/pages';
import { FEDERAIS, ESTADUAIS, EXTERIOR, ORGANISMOS } from '../../data/reguladores';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const c = PAGES.reguladores[lang];
const title = `${c.hero.title} — LOGIS`;

const T = {
  pt: {
    g1: 'Brasil — agências federais', g2: 'Brasil — 27 unidades da federação', g3: 'Exterior', g4: 'Organismos internacionais',
    orgao: 'Órgão', papel: 'Papel', site: 'Site', uf: 'UF', pais: 'País', tema: 'Tema',
  },
  en: {
    g1: 'Brazil — federal agencies', g2: 'Brazil — 27 federative units', g3: 'Abroad', g4: 'International organizations',
    orgao: 'Body', papel: 'Role', site: 'Website', uf: 'State', pais: 'Country', tema: 'Theme',
  },
  es: {
    g1: 'Brasil — agencias federales', g2: 'Brasil — 27 unidades federativas', g3: 'Exterior', g4: 'Organismos internacionales',
    orgao: 'Organismo', papel: 'Rol', site: 'Sitio', uf: 'UF', pais: 'País', tema: 'Tema',
  },
}[lang];
---

<Base lang={lang} slug="reguladores" title={title} description={c.hero.sub}>
  <section class="hero">
    <div class="container">
      <span class="kicker">{c.hero.kicker}</span>
      <h1>{c.hero.title}</h1>
      <p class="sub">{c.hero.sub}</p>
    </div>
  </section>

  <section class="block">
    <div class="container">
      <div class="prose" style="margin-bottom:10px;">
        {c.paragrafos!.map((p) => <p>{p}</p>)}
      </div>

      <h3 class="group-title">{T.g1}</h3>
      <div class="table-wrap">
        <table class="data">
          <thead><tr><th>{T.orgao}</th><th>{T.papel}</th><th>{T.site}</th></tr></thead>
          <tbody>
            {FEDERAIS.map((r) => (
              <tr>
                <td><strong>{r.orgao}</strong></td>
                <td>{r.papel}</td>
                <td><a href={r.url} target="_blank" rel="noopener noreferrer">{r.url.replace('https://', '')}</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h3 class="group-title">{T.g2}</h3>
      <div class="table-wrap">
        <table class="data">
          <thead><tr><th>{T.uf}</th><th>{T.orgao}</th><th>{T.site}</th></tr></thead>
          <tbody>
            {ESTADUAIS.map((r) => (
              <tr>
                <td><strong>{r.uf}</strong></td>
                <td>{r.orgao}</td>
                <td><a href={r.url} target="_blank" rel="noopener noreferrer">{r.url.replace(/^https?:\/\//, '')}</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h3 class="group-title">{T.g3}</h3>
      <div class="table-wrap">
        <table class="data">
          <thead><tr><th>{T.pais}</th><th>{T.orgao}</th><th>{T.site}</th></tr></thead>
          <tbody>
            {EXTERIOR.map((r) => (
              <tr>
                <td>{r.pais}</td>
                <td><strong>{r.orgao}</strong></td>
                <td><a href={r.url} target="_blank" rel="noopener noreferrer">{r.url.replace('https://', '')}</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h3 class="group-title">{T.g4}</h3>
      <div class="table-wrap">
        <table class="data">
          <thead><tr><th>{T.orgao}</th><th>{T.tema}</th><th>{T.site}</th></tr></thead>
          <tbody>
            {ORGANISMOS.map((r) => (
              <tr>
                <td><strong>{r.orgao}</strong></td>
                <td>{r.tema}</td>
                <td><a href={r.url} target="_blank" rel="noopener noreferrer">{r.url.replace('https://', '')}</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</Base>
