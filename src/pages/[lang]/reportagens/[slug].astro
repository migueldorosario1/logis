---
import Base from '../../../layouts/Base.astro';
import GraficosArtigo from '../../../components/GraficosArtigo.astro';
import { LANGS, type Lang, langPath } from '../../../content/ui';
import { REPORTAGENS } from '../../../data/reportagens';

export function getStaticPaths() {
  return REPORTAGENS.flatMap((r) =>
    LANGS.map((lang) => ({ params: { lang, slug: r.slug } }))
  );
}
const lang = Astro.params.lang as Lang;
const slug = Astro.params.slug as string;
const r = REPORTAGENS.find((x) => x.slug === slug)!;
const title = `${r.titulo[lang]} — LOGIS`;
const isFull = lang === 'pt';

// Links silenciosos: [texto](https://…) vira <a> — só aceita https, conteúdo é nosso.
const mdLinks = (p: string) =>
  p.replace(/\[([^\]]+)\]\((https:\/\/[^\s)]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>');
const graficosApos = (i: number) =>
  lang === 'pt' ? (r.graficos ?? []).filter((g) => g.apos === i) : [];

const T = {
  pt: { lerEditorial: 'Ler os editoriais', completo: '', notas: 'Notas e fontes da reportagem' },
  en: { lerEditorial: 'Read the editorials', completo: 'Full text in Portuguese · Resumo em inglês', notas: 'Notes and sources' },
  es: { lerEditorial: 'Leer los editoriales', completo: 'Texto integral en portugués · Resumen en español', notas: 'Notas y fuentes' },
}[lang];
---

<Base lang={lang} slug="reportagens" title={title} description={r.olho[lang]}>
  <section class="hero compact">
    <div class="container">
      <span class="kicker">{r.kicker[lang]} · {r.data}</span>
      <h1>{r.titulo[lang]}</h1>
      <p class="sub">{r.olho[lang]}</p>
      <p class="byline">Por {r.autor}</p>
    </div>
  </section>

  <section class="block">
    <div class="container">
      <figure class="rep-foto">
        <img src={r.foto.src} alt={r.foto.descricao} loading="lazy" />
        <figcaption>
          {r.foto.descricao} — Foto: {r.foto.credito} · Licença: {r.foto.licenca} (Wikimedia Commons)
        </figcaption>
      </figure>

      <article class="editorial">
        {r.corpo[lang].map((p, i) => (
          <Fragment>
            <p set:html={mdLinks(p)} />
            {graficosApos(i).map((g) => <GraficosArtigo id={g.id} />)}
          </Fragment>
        ))}
      </article>

      <div class="rep-assinatura">
        <div class="rep-assinatura-nome">{r.assinatura.linha1}</div>
        <div class="rep-assinatura-cargo">{r.assinatura.linha2}</div>
      </div>

      {r.notas && (
        <div class="rep-notas-link">
          <a class="btn ghost" href={langPath(lang, `reportagens/${r.slug}/notas`)}>📝 {T.notas} →</a>
        </div>
      )}

      {!isFull && (
        <p class="nota" style="margin-top:18px;">{T.completo}</p>
      )}

      <div style="margin-top:22px;">
        <a class="btn ghost" href={langPath(lang, 'editorial')}>{T.lerEditorial} →</a>
      </div>
    </div>
  </section>
</Base>
