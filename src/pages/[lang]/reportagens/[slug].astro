---
import Base from '../../../layouts/Base.astro';
import GraficosArtigo from '../../../components/GraficosArtigo.astro';
import { LANGS, type Lang, langPath } from '../../../content/ui';
import { REPORTAGENS, slugRep } from '../../../data/reportagens';

export function getStaticPaths() {
  return REPORTAGENS.flatMap((r) =>
    LANGS.map((lang) => ({ params: { lang, slug: slugRep(r, lang) } }))
  );
}
const lang = Astro.params.lang as Lang;
const slug = Astro.params.slug as string;
const r = REPORTAGENS.find((x) => slugRep(x, lang) === slug)!;
const repPaths = Object.fromEntries(LANGS.map((l) => [l, `reportagens/${slugRep(r, l)}`])) as Record<Lang, string>;
const title = `${r.titulo[lang]} — LOGIS`;

// Links silenciosos: [texto](https://…) vira <a> — só aceita https, conteúdo é nosso.
const mdLinks = (p: string) =>
  p.replace(/\[([^\]]+)\]\((https:\/\/[^\s)]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>');
const graficosApos = (i: number) => (r.graficos ?? []).filter((g) => g.apos === i);

// Versão definitiva, sem seletor (decisão Miguel 09/09/2026). Citações bíblica e clássica
// vivem TECIDAS nos parágrafos do corpo (2ª ordem 09/09: sem blocos destacados).
// V1-V7 arquivadas em arquivo_versoes_capa/.

const T = {
  pt: { lerEditorial: 'Ler os editoriais', notas: 'Notas e fontes da reportagem' },
  en: { lerEditorial: 'Read the editorials', notas: 'Notes and sources' },
  es: { lerEditorial: 'Leer los editoriales', notas: 'Notas y fuentes' },
}[lang];
---

<Base lang={lang} slug={`reportagens/${r.slug}`} paths={repPaths} title={title} description={r.olho[lang]}>
  <Fragment slot="head">
    {r.ilustracao && <>
    <link rel="canonical" href={`https://logis-magazine.vercel.app/${lang}/reportagens/${slugRep(r, lang)}/`} />
    {LANGS.map(l => <link rel="alternate" hreflang={l} href={`https://logis-magazine.vercel.app/${l}/reportagens/${slugRep(r, l)}/`} />)}
    <meta property="og:image" content={`https://logis-magazine.vercel.app${r.foto.src}`} />
    </>}
  </Fragment>
  <section class="hero compact">
    <div class="container">
      <span class="kicker">{r.kicker[lang]} · {r.data}</span>
      <h1>{r.titulo[lang]}</h1>
      <p class="sub">{r.olho[lang]}</p>
      <p class="byline">{r.ilustracao && lang === "en" ? "By" : "Por"} {r.autor}</p>
    </div>
  </section>

  <section class="block">
    <div class="container">
      <figure class="rep-foto">
        <img id="rep-foto-img" src={r.foto.src} alt={r.ilustracao?.[lang].descricao ?? r.foto.descricao} loading="lazy" />
        <figcaption id="rep-foto-caption">
          {r.ilustracao ? r.ilustracao[lang].legenda : `${r.foto.descricao} — Foto: ${r.foto.credito} · Licença: ${r.foto.licenca} (Wikimedia Commons)`}
        </figcaption>
      </figure>

      <article class="editorial">
        {r.corpo[lang].map((p, i) => (
          <Fragment>
            {p.startsWith("## ") ? <h2>{p.slice(3)}</h2> : <p set:html={mdLinks(p)} />}
            {graficosApos(i).map((g) => <GraficosArtigo id={g.id} lang={lang} />)}
          </Fragment>
        ))}
      </article>

      <div class="rep-assinatura">
        <div class="rep-assinatura-nome">{r.assinatura.linha1}</div>
        <div class="rep-assinatura-cargo">{r.assinatura.linha2}</div>
      </div>

      {r.notas && (
        <div class="rep-notas-link">
          <a class="btn ghost" href={langPath(lang, `reportagens/${slugRep(r, lang)}/notas`)}>📝 {T.notas} →</a>
        </div>
      )}

      <div style="margin-top:22px;">
        <a class="btn ghost" href={langPath(lang, 'editorial')}>{T.lerEditorial} →</a>
      </div>
    </div>
  </section>
</Base>
