---
import Base from '../../layouts/Base.astro';
import { LANGS, type Lang, langPath } from '../../content/ui';
import { PAGES } from '../../content/pages';
import { FONTES } from '../../data/rss';
import { REPORTAGENS } from '../../data/reportagens';
import { NOTICIAS } from '../../data/noticias';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const c = PAGES.home[lang];
const e = PAGES.editorial[lang];
const rep = REPORTAGENS[0];
const title = 'LOGIS';

// Ícones das notícias da capa (traço claro sobre o gradiente escuro)
const ICONES_NOTICIA: Record<string, string> = {
  corredores: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 30h30a6 6 0 0 0 0-12"/><path d="M6 30v6M36 18v-6"/><circle cx="40" cy="24" r="4" fill="currentColor" stroke="none" opacity=".9"/><path d="M10 36h6M22 36h6"/></svg>`,
  ferrovias: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M10 40L24 8l14 32"/><path d="M15.5 29h17M13 35h22M18 23h12"/><circle cx="24" cy="40" r="2.4" fill="currentColor" stroke="none" opacity=".9"/></svg>`,
  portos: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M8 40h32"/><path d="M14 40V22M22 40V22M30 40V22M38 40V22" /><rect x="11" y="14" width="26" height="8" rx="1.5"/><path d="M24 14V6"/><path d="M18 6h12"/></svg>`,
  verde: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M24 44S7 36 7 21V9l17-5 17 5v12c0 15-17 23-17 23z" fill="currentColor" fill-opacity=".15"/><path d="M24 14v20M24 24c0-5-4-9-9-10 0 6 4 10 9 10z" fill="currentColor" fill-opacity=".25"/></svg>`,
};

// Ilustrações (SVG inline, traço verde — uma por card)
const ILUSTRAS: Record<string, string> = {
  geomapas: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="24" cy="24" r="17"/><ellipse cx="24" cy="24" rx="7.5" ry="17"/><path d="M8 18h32M8 30h32"/><path d="M12 36C18 28 30 26 40 14" stroke-width="2.1"/><circle cx="12" cy="36" r="2.3" fill="currentColor" stroke="none"/><circle cx="40" cy="14" r="2.3" fill="currentColor" stroke="none"/></svg>`,
  reguladores: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M24 6v30"/><path d="M10 40h28"/><path d="M24 10l12 5-12 5-12-5 12-5z" fill="currentColor" fill-opacity=".12"/><path d="M12 15v8c0 2.5 5.4 4.5 12 4.5s12-2 12-4.5v-8"/><path d="M6 40h8M34 40h8M12 36l-4 4M36 36l4 4"/></svg>`,
  sustentabilidade: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M24 44S7 36 7 21V9l17-5 17 5v12c0 15-17 23-17 23z" fill="currentColor" fill-opacity=".08"/><path d="M24 12v22"/><path d="M24 22c0-5-4-9-10-10 0 6 4 10 10 10z" fill="currentColor" fill-opacity=".2"/><path d="M24 30c0-5 4-9 10-10 0 6-4 10-10 10z" fill="currentColor" fill-opacity=".2"/></svg>`,
  revista: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M6 12c6-2 10-2 14 1v25c-4-3-8-3-14-1V12z" fill="currentColor" fill-opacity=".1"/><path d="M42 12c-6-2-10-2-14 1v25c4-3 8-3 14-1V12z"/><path d="M20 13v25"/><path d="M11 19h5M11 24h5M32 19h5M32 24h5"/></svg>`,
  institucional: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M6 20L24 8l18 12" fill="currentColor" fill-opacity=".12"/><path d="M10 20v18M18 20v18M30 20v18M38 20v18"/><path d="M6 38h36"/><path d="M22 14h4v4h-4z" fill="currentColor" fill-opacity=".25"/></svg>`,
};

const T = {
  pt: { ler: 'Ler a reportagem completa', por: 'Por', noticiasK: 'Atualizado semanalmente', noticiasT: 'Últimas notícias', revKicker: 'Revista Logis · Edição nº 1 · prévia', revTitulo: 'Dossiê: corredores de escoamento e controle logístico', revTexto: 'Chancay, a ferrovia bioceânica e o desafio das fronteiras abertas. A capa e o sumário da primeira edição já estão prontos para baixar — conteúdo real, nada demonstrativo.', revLer: 'Ler a prévia da edição', revVer: 'Conhecer a revista', editorialK: 'Editorial semanal', rssTitulo: 'Do mundo da logística — fontes', rssTexto: 'Os portais que o LOGIS acompanha toda semana. Próxima etapa: tradução automática dos feeds para a língua do site.', emBreve: 'tradução automática em construção' },
  en: { ler: 'Read the full story', por: 'By', noticiasK: 'Updated weekly', noticiasT: 'Latest news', revKicker: 'Logis Journal · Issue No. 1 · preview', revTitulo: 'Dossier: export corridors and logistics control', revTexto: 'Chancay, the bioceanic railway and the challenge of open borders. The first issue’s cover and contents are ready to download — real content, nothing dummy.', revLer: 'Read the issue preview', revVer: 'About the journal', editorialK: 'Weekly editorial', rssTitulo: 'From the world of logistics — sources', rssTexto: 'The outlets LOGIS follows every week. Next step: automatic feed translation into the site’s languages.', emBreve: 'automatic translation under construction' },
  es: { ler: 'Leer la reportaje completa', por: 'Por', noticiasK: 'Actualizado semanalmente', noticiasT: 'Últimas noticias', revKicker: 'Revista Logis · Edición nº 1 · avance', revTitulo: 'Dossier: corredores de escoamiento y control logístico', revTexto: 'Chancay, el ferrocarril bioceánico y el desafío de las fronteras abiertas. La portada y el sumario de la primera edición ya están listos para descargar — contenido real, nada demostrativo.', revLer: 'Leer el avance de la edición', revVer: 'Conocer la revista', editorialK: 'Editorial semanal', rssTitulo: 'Del mundo de la logística — fuentes', rssTexto: 'Los portales que LOGIS sigue cada semana. Próximo paso: traducción automática de los feeds al idioma del sitio.', emBreve: 'traducción automática en construcción' },
}[lang];

const REVISTA_PDF = {
  pt: '/downloads/revista-logis-edicao1-pt.pdf',
  en: '/downloads/revista-logis-edicao1-en.pdf',
  es: '/downloads/revista-logis-edicao1-es.pdf',
}[lang];
---

<Base lang={lang} slug="" title={title} description={rep.olho[lang]}>
  <section class="manchete">
    <div class="container">
      <div class="manchete-grid">
        <div class="manchete-texto">
          <a class="manchete-kicker" href={langPath(lang, `reportagens/${rep.slug}`)}>{rep.kicker[lang]} · {rep.data}</a>
          <h1 class="manchete-titulo">{rep.titulo[lang]}</h1>
          <p class="manchete-tese">{rep.olho[lang]}</p>
          <div class="ctas">
            <a class="btn primary manchete-btn" href={langPath(lang, `reportagens/${rep.slug}`)}>
              <span class="manchete-btn-frase">{T.ler} →</span>
              <span class="manchete-btn-autor">{T.por} {rep.autor}</span>
            </a>
          </div>
        </div>
        <a class="manchete-foto" href={langPath(lang, `reportagens/${rep.slug}`)} aria-label={rep.titulo[lang]}>
          <img src={rep.foto.src} alt={rep.foto.descricao} />
        </a>
      </div>
    </div>
  </section>

  <section class="faixa-editorial">
    <div class="container">
      <a class="faixa-link" href={langPath(lang, 'editorial')}>
        <span class="faixa-kicker">{T.editorialK}</span>
        <span class="faixa-titulo">{e.hero.title}</span>
        <span class="faixa-seta">→</span>
      </a>
    </div>
  </section>

  <section class="block noticias">
    <div class="container">
      <div class="noticias-cabecalho">
        <h2 class="group-title" style="margin:0;">{T.noticiasT}</h2>
        <span class="noticias-badge">{T.noticiasK}</span>
      </div>
      <div class="noticias-grid">
        {NOTICIAS.map((n) => (
          <a class={`noticia-card tema-${n.tema}`} href={n.url} target="_blank" rel="noopener noreferrer">
            <span class="noticia-icone" set:html={ICONES_NOTICIA[n.tema]} />
            <span class="noticia-texto">
              <span class="noticia-kicker">{n.fonte} · {n.data}</span>
              <span class="noticia-titulo">{n.titulo[lang]} ↗</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="block revista-destaque">
    <div class="container">
      <a class="revista-card" href={langPath(lang, 'revista/visualizador')}>
        <span class="revista-capa">
          <img src={`/imagens/revista-capa-${lang}.png`} alt={T.revTitulo} loading="lazy" />
        </span>
        <span class="revista-info">
          <span class="revista-kicker">{T.revKicker}</span>
          <h2 class="revista-titulo">{T.revTitulo}</h2>
          <p class="revista-texto">{T.revTexto}</p>
        </span>
      </a>
      <div class="revista-botoes">
        <a class="btn primary" href={langPath(lang, 'revista/visualizador')}>📖 {T.revLer}</a>
        <a class="btn ghost" href={langPath(lang, 'revista')}>{T.revVer} →</a>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="container">
      <div class="cards">
        {c.blocos!.map((b) => (
          <a class="card link" href={langPath(lang, b.slug ?? '')}>
            {b.slug && ILUSTRAS[b.slug] && <span class="ilustra" set:html={ILUSTRAS[b.slug]} />}
            <h3>{b.t}</h3>
            <p>{b.x}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="block alt">
    <div class="container">
      <h2 class="group-title">{T.rssTitulo}</h2>
      <div class="rss-grid">
        {FONTES.map((f) => (
          <a class="rss-item" href={f.url} target="_blank" rel="noopener noreferrer">
            <strong>{f.nome}</strong>
            <span>{f.pais} · RSS</span>
          </a>
        ))}
      </div>
      <p class="nota" style="margin-top:18px;">{T.rssTexto} <em>({T.emBreve})</em></p>
    </div>
  </section>
</Base>
